# ===== GyaanSetu LMS — Environment Template =====
# Copy this file to `.env` (server/.env is also read) and fill in real values.
# NEVER commit a real .env file. Secrets below are examples only.

# ---------- Server ----------
# Port the API listens on. Hostinger injects PORT automatically.
PORT=5000

# Runtime mode. Set to "production" on Hostinger so secure cookies / helmet apply.
NODE_ENV=production

# CORS: comma-separated list of allowed frontend origins.
# If the backend also serves the SPA (recommended), set this to your domain,
# e.g. https://gyaansetu.app,https://www.gyaansetu.app
CORS_ORIGIN=

# Frontend origin (used for CORS / cookie hints). Same as your production domain.
FRONTEND_URL=https://gyaansetu.app

# JWT signing secret — MUST be a long random string in production.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# Access token lifetime (seconds). Default 15 minutes.
JWT_ACCESS_EXPIRES_IN=900
# Refresh token lifetime (seconds). Default 30 days.
JWT_REFRESH_EXPIRES_IN=2592000

# Uploaded files directory (relative to app root). Persisted on the server.
UPLOAD_DIR=./uploads
# Allowed upload extensions (comma separated, no dots).
ALLOWED_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,jpg,jpeg,png,webp,gif,mp4,webm,mp3,zip,txt
# Max upload size in megabytes.
MAX_UPLOAD_MB=25

# Embedded PostgreSQL (pglite) data directory. Persisted on the server.
# Leave default (./.data) or set an absolute persistent path.
DATA_DIR=./.data

# Optional: absolute path to the built client SPA. Leave empty to auto-detect ./client/dist
CLIENT_DIST=

# Trust Hostinger's reverse proxy (sets X-Forwarded-*). Keep "1" in production.
TRUST_PROXY=1

# ---------- Database seed (first deploy only) ----------
# Override the default admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@gyaansetu.app
SEED_ADMIN_PASSWORD=Admin@123

# ---------- Client (build-time only, used by `npm --prefix client run build`) ----------
# API base path. Empty or "/api" => same-origin (backend serves the SPA).
# Only set a full URL if the API is on a different domain.
VITE_API_URL=/api
# Where the dev server proxies /api and /uploads (dev only, ignored in build).
VITE_PROXY_TARGET=http://localhost:5000
# Public base URL for absolute links / PWA. Optional.
VITE_APP_URL=https://gyaansetu.app

# ---------- Dev / Demo only ----------
# When true, the forgot-password endpoint returns a usable reset token in the
# JSON response (so you can test without an email server). NEVER enable in prod.
DEV_RETURN_RESET_TOKEN=false
